    "bin",
    "src",
    "web",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/ai-work-board.mjs",
    "demo": "node bin/ai-work-board.mjs --demo",
    "test": "node --test"
  },
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keyakilabs/ai-work-board.git"
  },
  "homepage": "https://github.com/keyakilabs/ai-work-board#readme",
  "bugs": {
    "url": "https://github.com/keyakilabs/ai-work-board/issues"
  },
  "keywords": [
    "claude-code",
